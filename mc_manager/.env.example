#optional: if you want to use an invoice service - using Splitwise
INVOICE_SERVICE="SPLITWISE"
SPLITWISE_API_TOKEN="SPLITWISE_API_TOKEN"
SPLITWISE_GROUP_ID="SPLITWISE_GROUP_ID"

#optional: default is using file credentials
AWS_REGION_FILE="aws-region.txt"
AWS_ACCESS_KEY_ID_FILE="aws-access-key-id.txt"
AWS_SECRET_ACCESS_KEY_FILE="aws-secret-access-key.txt"

#optional: or define them directly
AWS_REGION="YOUR_AWS_REGION"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"


#other optional evns and their defaults
AWS_PROJECT_NAME="minecraft"
MC_SERVER_SSH_USER="ec2-user"
MC_SERVER_SSH_KEY_FILE="aws-server-key.pem"
DATA_PATH="./data"
DASHBOARD_PORT=8080
TRANSFER_SERVER_PORT=25565