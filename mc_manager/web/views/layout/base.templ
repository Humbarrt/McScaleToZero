package layout

templ Base() {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title>MC Billing Split</title>
            <link rel="icon" href="/static/favicon.ico" />
            <!-- tailwind css -->
            <style>
                    :root {
                        --block-size: 48px;
                        --nav-height: 70px;
                        --main-height: calc(100vh - (var(--block-size) * (2 + 3)));
                        cursor: url('data:@file/x-123;base64,'), auto;
                    }
            </style>
            <link href="/static/css/tailwind.css" rel="stylesheet"/>
            <link href="/static/css/base.css" rel="stylesheet"/>
            <link href="/static/css/minecraft.css" rel="stylesheet"/>
        </head>
        
        <body class="w-screen h-screen overflow-hidden scrollbar">
            <main class="absolute top-0 bottom-0 left-0 right-0 flex flex-col ">
                <!-- header -->
                @Header()
                { children... }
                <div id="footerPlaceholder" class="w-full h-1-block"></div>
            <!-- htmx -->
            <script src="https://unpkg.com/htmx.org@1.9.10"></script>
            </main>
            @Footer()
            <div class="absolute top-0 left-0 right-0 bottom-0 bg-block-stone z-[-1]">
                <div class="absolute top-0 left-0 right-0 bottom-0 bg-cover bg-gradient-to-t from-[rgba(0,0,0,0.75)] to-[rgba(0,0,0,0.4)]"></div>
            </div>
        </body>
    </html>
}
