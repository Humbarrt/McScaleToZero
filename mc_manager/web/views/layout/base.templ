package layout

templ Base(isSignedIn bool) {
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MC Billing Split</title>
    <link rel="icon" href="/static/favicon.ico" />
    <!-- tailwind css -->
    <style>
        :root {
            --block-size: 48px;
            --nav-height: 70px;
            --main-height: calc(100vh - (var(--block-size) * (2 + 3)));
        }

        .htmx-request.htmx-inverse-indicator {
            display: none;
        }

        .htmx-request .htmx-inverse-indicator {
            display: none;
        }

        .htmx-request.htmx-inverse-indicator-opacity {
            visibility: hidden;
        }

        .htmx-request .htmx-inverse-indicator-opacity {
            visibility: hidden;
        }

        .htmx-request .htmx-indicator {
            display: block;
        }

        .htmx-request.htmx-indicator {
            display: block;
        }

        .htmx-indicator {
            display: none;
        }

        @keyframes indicatorAnimation {
            to {
                clip-path: inset(0 -34% 0 0)
            }
        }

        .indicator {
            width: calc((0.5rem * 3) + (0.25rem * 2) + 2px);
            height: 0.5rem;
            background: linear-gradient(white 0 0) 0% center / 0.5rem 0.5rem no-repeat, linear-gradient(white 0 0) 50% center / 0.5rem 0.5rem no-repeat, linear-gradient(white 0 0) 100% center / 0.5rem 0.5rem no-repeat;
            background-repeat: no-repeat;
            aspect-ratio: 4;
            background-position: calc(0% + 0 * (0.5rem + 0.25rem)) center, calc(0% + 1 * (0.5rem + 0.25rem)) center, calc(0% + 2 * (0.5rem + 0.25rem)) center;
            clip-path: inset(0 100% -100% 0);
            filter: drop-shadow(1.5px 1.5px #000);
            animation: indicatorAnimation 1s steps(4) infinite;
        }

        h2 {
            font-size: 2.5rem !important;
            margin: 0.75rem 0 0.25rem 0 !important;
            text-shadow: 1.5px 1.5px #000;
            font-family: 'Minecraft', sans-serif;
            color: #fff
        }

        h3 {
            font-size: 1.5rem !important;
            margin: 0.5rem 0 0.5rem 0 !important;
            text-shadow: 1px 1px #000;
            font-family: 'Minecraft', sans-serif;
            color: #fff
        }

        .disabled\:text-shadow-none:disabled {
            text-shadow: none !important;
        }

        .custom-select select {
            background: none;
            -moz-appearance: none;
            -webkit-appearance: none;
            appearance: none;
            padding-right: 2rem;
        }

        .custom-select {
            position: relative;
        }

        .custom-select::after {
            content: url("data:image/svg+xml,%3Csvg fill='none' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M7 8H5v2h2v2h2v2h2v2h2v-2h2v-2h2v-2h2V8h-2v2h-2v2h-2v2h-2v-2H9v-2H7V8z' fill='white'/%3E%3C/svg%3E");
            position: absolute;
            top: 50%;
            right: 0.5rem;
            transform: translate(0, -50%);
            pointer-events: none;
            width: 1.25rem;
            height: 1.25rem;
            -moz-appearance: none;
            -webkit-appearance: none;
            appearance: none;
        }

        .custom-select.disabled::after {
            content: url("data:image/svg+xml,%3Csvg fill='none' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M7 8H5v2h2v2h2v2h2v2h2v-2h2v-2h2v-2h2V8h-2v2h-2v2h-2v2h-2v-2H9v-2H7V8z' fill='black'/%3E%3C/svg%3E");
        }
    </style>
    <link rel="stylesheet" href="/static/css/tailwind.css" />
    <link rel="stylesheet" href="/static/css/base.css" />
    <link rel="stylesheet" href="/static/css/minecraft.css" />
    <link rel="stylesheet" href="/static/css/charts.min.css">
</head>

<body class="w-screen h-screen overflow-hidden scrollbar">
    <main class="absolute top-0 bottom-0 left-0 right-0 flex flex-col overflow-scroll">
        <!-- header -->
        @Header(isSignedIn)
        { children... }
        <div id="footerPlaceholder" class="w-full m-auto"></div>
        @Footer()
        <!-- htmx -->
        <script type="text/javascript" src="/static/htmx/htmx.org@2.0.4.js"
            integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"></script>
        <script type="text/javascript" src="/static/htmx/htmx-ext-sse@2.2.3.js"
            integrity="sha384-Y4gc0CK6Kg+hmulDc6rZPJu0tqvk7EWlih0Oh+2OkAi1ZDlCbBDCQEE2uVk472Ky"></script>
        <script type="text/javascript" src="/static/htmx/htmx-ext-response-targets@2.0.2.js"
            integrity="sha384-NtTh9TBZ2X/pFpfsVvQOjSsYWmjmqG6h5ioQWVAe2/j3AuTHRmfqvoqp+iOed+I0"></script>
    </main>
    <div class="absolute top-0 left-0 right-0 bottom-0 bg-block-stone z-[-1]">
        <div
            class="absolute top-0 left-0 right-0 bottom-0 bg-cover bg-gradient-to-t from-[rgba(0,0,0,0.75)] to-[rgba(0,0,0,0.4)]">
        </div>
    </div>
</body>

</html>
}