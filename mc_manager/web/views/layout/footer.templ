package layout

import "fmt"

templ sseConnectionIndicator(state string) {
    <div class="relative flex flex-row items-center hidden gap-2 text-panel group" id={fmt.Sprintf("%sSSEConnectionIndicator", state)}>
        <img class="min-w-6 min-h-6" src={fmt.Sprintf("/static/imgs/ui/%s.png", state)} style="image-rendering: pixelated;" alt={state}/>
        <span class="absolute right-0 px-2 py-1 transition-opacity bg-black rounded opacity-0 pointer-events-none -top-4 w-max group-hover:opacity-100">
            {state}
        </span>
    </div>
}


templ Footer() {
    <div class="relative bottom-0 left-0 right-0 flex flex-row bg-block-bedrock min-h-1-block">
        <span class="flex justify-between w-full h-full px-4 felx-row bg-black/75 ">
            <a class="flex flex-row items-center h-full gap-2 text-panel hover:text-white" href="https://github.com/Humbarrt/McScaleToZero">
                <div class="w-6">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path fill="currentColor" d="M5 2h4v2H7v2H5V2Zm0 10H3V6h2v6Zm2 2H5v-2h2v2Zm2 2v-2H7v2H3v-2H1v2h2v2h4v4h2v-4h2v-2H9Zm0 0v2H7v-2h2Zm6-12v2H9V4h6Zm4 2h-2V4h-2V2h4v4Zm0 6V6h2v6h-2Zm-2 2v-2h2v2h-2Zm-2 2v-2h2v2h-2Zm0 2h-2v-2h2v2Zm0 0h2v4h-2v-4Z"/> </svg>
                </div>
                <p class="flex text-xl text-center h-min">By M.H. & J.A.</p>
            </a>
            @sseConnectionIndicator("connected")
            @sseConnectionIndicator("disconnected")
        </span>
    </div>
    <script>
        function setSSEConnectionIndicator(isConnected) {
            const connectedIndicator = document.getElementById("connectedSSEConnectionIndicator");
            const disconnectedIndicator = document.getElementById("disconnectedSSEConnectionIndicator");
            if (connectedIndicator === null || disconnectedIndicator === null) {
                return;
            }

            if (isConnected) {
                connectedIndicator.classList.remove("hidden");
                disconnectedIndicator.classList.add("hidden");
            } else {
                connectedIndicator.classList.add("hidden");
                disconnectedIndicator.classList.remove("hidden");
            }
        }
        document.body.addEventListener('htmx:sseOpen', function (e) {
            setSSEConnectionIndicator(true);
        })
        document.body.addEventListener('htmx:sseBeforeMessage', function (e) {
            setSSEConnectionIndicator(true);
        })
        document.body.addEventListener('htmx:sseClose', function (e) {
            setSSEConnectionIndicator(false);
        })
        document.body.addEventListener('htmx:sseError', function (e) {
            setSSEConnectionIndicator(false);
        })
    
    </script>
}