package layout

templ Header() {
    <header class="w-full h-1-block sm:h-2-block bg-block-dirt">
        <div class="w-full h-full !bg-repeat-x bg-block-grass-side">
            <div class="flex flex-row w-full h-full bg-cover items-center justify-center sm:justify-start bg-gradient-to-t px-8 from-[rgba(0,0,0,0.4)] to-[rgba(0,0,0,0.0)]">
                <img src="/static/imgs/banner.png" class="flex flex-row h-auto text-2xl text-white w-60 sm:text-5xl sm:w-96" alt="MC Billing Split"/>
            </div>
        </div>
    </header>
}