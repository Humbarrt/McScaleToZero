package layout

templ Header(isSignedIn bool) {
    <header class="flex w-full bg-block-dirt">
        <div class="w-full h-full !bg-repeat-x bg-block-grass-side">
            <div class="flex flex-col sm:flex-row w-full h-full bg-cover items-center justify-between bg-gradient-to-t px-2 sm:px-8 py-2 from-[rgba(0,0,0,0.4)] to-[rgba(0,0,0,0.0)]">
                <img src="/static/imgs/banner.png" class="flex flex-row h-auto py-2 mt-2 text-2xl text-white sm:py-1 w-60 sm:text-5xl sm:w-72" alt="MC Billing Split"/>
                /* <img src="/static/imgs/banner-large.png" class="flex-row hidden w-[8.5rem] h-auto mt-2 text-2xl text-white sm:text-5xl sm:flex" alt="MC Billing Split"/> */
                if isSignedIn {

                    <button class="relative flex flex-row items-center justify-center gap-2 px-4 py-2 mt-2 group" hx-get="/auth/logout" hx-disabled-elt="this">
                        <div class="text-white text-md sm:hidden sm:text-xl text-shadow-md">Logout</div>
                        <div class="relative w-6 h-6">
                            <svg class="absolute w-6 h-6 text-black top-[1px]" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path d="M5 3h16v4h-2V5H5v14h14v-2h2v4H3V3h2zm16 8h-2V9h-2V7h-2v2h2v2H7v2h10v2h-2v2h2v-2h2v-2h2v-2z" fill="currentColor"/> </svg>
                            <svg class="absolute w-6 h-6 text-white" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path d="M5 3h16v4h-2V5H5v14h14v-2h2v4H3V3h2zm16 8h-2V9h-2V7h-2v2h2v2H7v2h10v2h-2v2h2v-2h2v-2h2v-2z" fill="currentColor"/> </svg>
                        </div>
                        <span class="absolute right-0 px-2 py-1 text-white transition-opacity bg-black rounded opacity-0 pointer-events-none top-9 w-max group-hover:opacity-100">
                            Logout
                        </span>
                    </button>
                }
            </div>
        </div>
    </header>
}