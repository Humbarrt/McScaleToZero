package auth

import (
    "mc_manager/web/views/utils"
	"mc_manager/model"
    "fmt"
)

templ PasswordResetForm(player *model.Player, session model.PasswordResetSession, err error) {
    {{  
        playerIdString := ""
        if player != nil {
            playerIdString = fmt.Sprintf("%d", player.Id)
        }

        clientKey := []byte{}
        if session != nil {
            clientKey = session.GetClientKey()
        }

        sessionId := ""
        if session != nil {
            sessionId = session.GetId()
        }

    }}
    <form 
        hx-post="/auth/reset"
        hx-target="#auth"
        hx-swap="innerHTML"
        hx-on:htmx:before-request="passwordResetProcess()"
        hx-vals={ fmt.Sprintf(`{"playerId": %s, "sessionId": "%s"}`, playerIdString, sessionId) }
    >
        <label for="password" class="block mb-2 text-dark-gray">Choose a new Password</label>
        <input type="password" id="password"
            class="w-full mb-4 input"
            placeholder="Enter your new password"
            required
        />
        <label for="confirmPassword" class="block mb-2 text-dark-gray">Confirm Password</label>
        <input type="password" id="confirmPassword"
            class="w-full mb-1 input"
            placeholder="Enter your new password"
            required
        />
        <div class={"mt-1 text-dark-red", templ.KV("hidden", err == nil)} id="passwordErrorLabel">
            if err != nil {
                {err.Error()}
            }
        </div>
        
        <button class="w-full px-4 py-2 mt-5 text-lg btn raised-slot-button h-1-block whitespace-nowrap" type="submit">
            <span class="htmx-inverse-indicator">Continue</span>
            @utils.Indicator("resetIndicator", "m-auto")
        </button>
    </form>

    @templ.JSONScript("clientKey", clientKey)
    <script>
        function addFormError(elements, message) {
			let error_label = document.getElementById("passwordErrorLabel")
			if (error_label) {
				error_label.classList.remove("hidden");
				error_label.innerText = message;
			} else {
				console.error("Error label not found", "passwordErrorLabel")
			}
            if (!elements) {
                return;
            }

            for (let element of elements) {
                element.classList.add("form-error");
            }
		}

        function removeFormError(elements) {
			let error_label = document.getElementById("passwordErrorLabel")
			if (error_label) {
				error_label.classList.add("hidden");
			} else {
				console.error("Error label not found", "passwordErrorLabel")
			}
            if (!elements) {
                return;
            }
            
            for (let element of elements) {
                element.classList.remove("form-error");
            }
		}

        function validatePasswordResetForm(passwordElement, confirmPasswordElement, clientKey) {
            password = passwordElement?.value;
            confirmPassword = confirmPasswordElement?.value;
            elements = [passwordElement, confirmPasswordElement]

            if (clientKey == null || clientKey.length == 0|| passwordElement == null || confirmPasswordElement == null) {
                addFormError(null, "Invalid session, please reload page");
                return false;
            }

            removeFormError(elements);
            if (password.length < 8) {
                addFormError(elements, "Password must be at least 8 characters long");
                return false;
            }

            if (password.length > 64) {
                addFormError(elements, "Password must be less than 64 characters long");
                return false;
            }

            let re = new RegExp("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z\\d]).+$");
            if (!re.test(password)) {
                console.log("Password does not match regex", password, re)
                addFormError(elements, "Password must contain at least one uppercase letter, one lowercase letter, one number, and one special character");
                return false;
            }

            if (password !== confirmPassword) {
                addFormError([confirmPassword], "Passwords do not match");
                return false;
            }

            return true;
        }

        function passwordResetProcess() {
            try {
                clientKey = JSON.parse(document.getElementById('clientKey')?.textContent || "");
                passwordElement = document.getElementById("password")
                confirmPasswordElement = document.getElementById("confirmPassword");

                if (!validatePasswordResetForm(passwordElement, confirmPasswordElement, clientKey)) {
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }

                password = passwordElement.value;
                hashedPassword = hashPasswordWithKey(password, clientKey);
                unfilteredParameters = event?.detail?.requestConfig?.unfilteredParameters;
                parameters = event?.detail?.requestConfig?.parameters;
                if (unfilteredParameters == null || parameters == null) {
                    console.error("Error, unfilteredParameters or parameters are null");
                    event.preventDefault();
                    event.stopPropagation();
                    return;
                }
                unfilteredParameters.hashedPassword = hashedPassword;
                parameters.hashedPassword = hashedPassword;
            } catch (error) {
                console.error("Error", error)
                throw "Error, please try again"
            }
        }
    </script>
}