package auth

import (
    "mc_manager/model"
    "fmt"
    "time"
    "math"
)

templ WaitForChatToken(player *model.Player, session model.PasswordResetSession, err error) {
    {{  
        playerIdString := ""
        if player != nil {
            playerIdString = fmt.Sprintf("%d", player.Id)
        }

        timeLeftDuration := time.Duration(0)
        if session != nil {
            timeLeftDuration = time.Until(session.GetExpiration())
        }

        timeLeftMinutes := int(math.Ceil(math.Max(0, timeLeftDuration.Minutes())))
        timeLeftMinutesString := fmt.Sprintf("%d", timeLeftMinutes)
        if timeLeftMinutes > 1 {
            timeLeftMinutesString += " mins"
        } else {
            timeLeftMinutesString += " min"
        }

        sessionId := ""
        if session != nil {
            sessionId = session.GetId()
        }

        chatToken := ""
        if session != nil {
            chatToken = session.GetChatToken()
        }
    }}
    <div
        hx-get="/auth/reset"
        hx-target="#auth"
        hx-swap="innerHTML"
        hx-vals={ fmt.Sprintf(`{"playerId": %s, "sessionId": "%s"}`, playerIdString, sessionId) }
        hx-trigger="every 5s"
    >
        <div class="flex flex-col items-center justify-center">
            if player != nil {
                <div class="flex items-center justify-center mb-4">
                    <h3 class="text-2xl text-white text-shadow-md">Hi, {player.Aliases[0]}</h3>
                </div>
            }
            <h1 class="text-lg text-center">Please open Minecraft, join the server and paste the following message in the chat:</h1>
            <button class="relative justify-center p-3 my-3 achievement-panel group" type="button" onclick="copyToClipboard()" onmouseleave="resetClipboardIcons()">
                <p class="text-lg text-center text-white" id="chatToken">{chatToken}</p>
                <div class="absolute hidden group-hover:block w-6 text-lg text-black !bg-white top-2 right-2" id="chatTokenButton">
                    <svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" id="copyIcon"> <path d="M4 2h11v2H6v13H4V2zm4 4h12v16H8V6zm2 2v12h8V8h-8z" fill="currentColor"/> </svg>
                    <svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden" id="successIcon"> <path d="M18 6h2v2h-2V6zm-2 4V8h2v2h-2zm-2 2v-2h2v2h-2zm-2 2h2v-2h-2v2zm-2 2h2v-2h-2v2zm-2 0v2h2v-2H8zm-2-2h2v2H6v-2zm0 0H4v-2h2v2z" fill="currentColor"/> </svg>
                </div>
            </button>
        </div>
        <div class="flex flex-col items-center justify-center">
            <p class="text-lg text-center">The logs are not propagated instantly. It takes roughly 1 min, so please be patient.</p>
            <p class="text-lg text-center">You have {timeLeftMinutesString} left</p>
            if err != nil {
                <div class="mt-1 text-dark-red">{err.Error()}</div>
            }
        </div>
    </div>

    <script>
        async function copyToClipboard() {
            let chatToken = document.getElementById("chatToken");
            if (chatToken == null || chatToken.innerText == null) {
                alert("Error: Could not find the chat token element.");
                return;
            }

            await navigator.clipboard.writeText(chatToken.innerText);
            let copyIconElement = document.getElementById("copyIcon");
            let successIconElement = document.getElementById("successIcon");
            if (copyIconElement == null || successIconElement == null) {
                console.error("Error: Could not find the copy or success icon element.");
                return;
            }
            copyIconElement.classList.add("hidden");
            successIconElement.classList.remove("hidden");
        }
        
        function resetClipboardIcons() {
            let successIconElement = document.getElementById("successIcon");
            let copyIconElement = document.getElementById("copyIcon");
            if (successIconElement == null || copyIconElement == null) {
                console.error("Error: Could not find the success or copy icon element.");
                return;
            }
            successIconElement.classList.add("hidden");
            copyIconElement.classList.remove("hidden");
        }
    </script>
}