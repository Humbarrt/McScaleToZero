package widgets

import "mc_manager/model"

templ serverStatusLoader() {
    @widgetLoader("server-status", []model.EB_EventType{
        model.EB_EVENT_SERVER_ONLINE,
        model.EB_EVENT_SERVER_READY,
        model.EB_EVENT_SERVER_OFFLINE,
    })
}


templ serverIcon() {
    <svg fill="none" xmlns="http://www.w3.org/2000/svg" class="min-w-12 min-h-12" viewBox="0 0 24 24"> <path d="M3 3h18v18H3V3zm2 2v6h14V5H5zm14 8H5v6h14v-6zM7 7h2v2H7V7zm2 8H7v2h2v-2z" fill="currentColor"/> </svg>
}

templ ServerStatus(serverStatus model.ServerStatus) {
    @baseWidgetContent(serverIcon(), "Server Status"){
        if serverStatus == model.SERVER_STATUS_ONLINE {
            <span class="text-green">Online</span>
        } else if serverStatus == model.SERVER_STATUS_STARTING {
            <span class="text-gold">Starting</span>
        } else if serverStatus == model.SERVER_STATUS_OFFLINE {
            <span class="text-red">Offline</span>
        }
    }
}