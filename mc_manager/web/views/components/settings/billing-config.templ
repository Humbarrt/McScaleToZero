package settings

import (
    "mc_manager/model"
    "github.com/shopspring/decimal"
)

templ billingConfigLoader() {
    @sectionLoader("billing", []model.EB_EventType{
        model.EB_EVENT_BILLING_CONFIG_UPDATE,
    }, 251)
}

templ decimalInput(isAdmin bool, label string, name string, value decimal.Decimal, min string, max string, url string) {
    @HelperLabel(label, name, url)
    
    <input 
        class="w-full col-span-2 px-2 text-white slot text-shadow-xs sm:max-w-96 disabled:text-black disabled:text-shadow-none"
        value={value.StringFixed(4)}
        name={name}
        type="number"
        step="0.0001"
        min={min}
        max={max}
        disabled?={!isAdmin}
        required
    ></input>
}

templ BillingConfig(isAdmin bool, taxRate decimal.Decimal, networkRatio decimal.Decimal, fallbackFixedCost decimal.Decimal, fallbackVariableCost decimal.Decimal, hasSaved bool) {
    {{
        taxRatePercentage := taxRate.Mul(decimal.NewFromInt(100))
        networkRatioPercentage := networkRatio.Mul(decimal.NewFromInt(100))

    }}
    <div class="flex flex-row items-center justify-between w-full mb-3">
        <h3 class="">Billing Config</h3>
        if isAdmin {
            <div class="flex flex-row gap-2">
                <button
                class="flex items-center justify-center w-8 h-8 raised-slot-button" 
                disabled?={!isAdmin}
                hx-get="/components/settings/billing"
                hx-target="#billingHolder"
                hx-swap="innerHTML"
                hx-trigger="click"
                >
                    <svg fill="none" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path d="M16 4h-2v2h2v2H6v2H4v8h2v2h6v-2H6v-8h10v2h-2v2h2v-2h2v-2h2V8h-2V6h-2V4z" fill="currentColor"/> </svg>
                </button>
                <button 
                    class="flex items-center justify-center w-8 h-8 raised-slot-button"
                    disabled?={!isAdmin}
                    hx-post="/components/settings/billing"
                    hx-target-*="#billingErrorLabel"
                    hx-target="#billingHolder"
                    hx-swap="innerHTML"
                    hx-trigger="click"
                    hx-vals="js:{
                        taxRate: document.getElementsByName('taxRate')[0].value,
                        networkRatio: document.getElementsByName('networkRatio')[0].value,
                        fallbackFixedCost: document.getElementsByName('fallbackFixedCost')[0].value,
                        fallbackVariableCost: document.getElementsByName('fallbackVariableCost')[0].value
                    }"
                    onmouseleave="resetBillingSaveIcons()"
                >
                    <svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={"w-6 h-6", templ.KV("hidden", hasSaved)} id="billingSaveIcon" > <path d="M4 2h14v2H4v16h2v-6h12v6h2V6h2v16H2V2h2zm4 18h8v-4H8v4zM20 6h-2V4h2v2zM6 6h9v4H6V6z" fill="currentColor"/> </svg>
                    <svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={"w-6 h-6 text-green", templ.KV("hidden", !hasSaved)} id="billingSuccessIcon"> <path d="M18 6h2v2h-2V6zm-2 4V8h2v2h-2zm-2 2v-2h2v2h-2zm-2 2h2v-2h-2v2zm-2 2h2v-2h-2v2zm-2 0v2h2v-2H8zm-2-2h2v2H6v-2zm0 0H4v-2h2v2z" fill="currentColor"/> </svg>
                </button>
            </div>
        }
    </div>
    <div class="grid w-full grid-cols-[auto,auto] gap-4 sm:grid-cols-[auto,auto,auto] sm:max-w-max">
        @decimalInput(isAdmin, "Network Ratio (%)", "networkRatio", networkRatioPercentage, "0", "100", "https://github.com/Humbarrt/McScaleToZero/wiki/Settings#network-ratio")
        @decimalInput(isAdmin, "VAT (%)", "taxRate", taxRatePercentage, "0", "100", "https://github.com/Humbarrt/McScaleToZero/wiki/Settings#tax-rate")
        @decimalInput(isAdmin, "Fallback Fixed Cost ($/d)", "fallbackFixedCost", fallbackFixedCost, "0", "100", "https://github.com/Humbarrt/McScaleToZero/wiki/Settings#fallback-fixed-cost")
        @decimalInput(isAdmin, "Fallback Variable Cost ($/h)", "fallbackVariableCost", fallbackVariableCost, "0", "100", "https://github.com/Humbarrt/McScaleToZero/wiki/Settings#fallback-variable-cost")
    </div>
    <div class="mt-1 text-dark-red" id="billingErrorLabel"></div>
    <script>
        function resetBillingSaveIcons(event) {
            setTimeout(function() {
                let successIconElement = document.getElementById("billingSuccessIcon");
                let saveIconElement = document.getElementById("billingSaveIcon");
                if (successIconElement == null || saveIconElement == null) {
                    console.error("Error: Could not find the success or copy icon element.");
                    return;
                }
                successIconElement.classList.add("hidden");
                saveIconElement.classList.remove("hidden");
            }, 3000);
        }
    </script>
}