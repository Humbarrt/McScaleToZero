package playtime

import (
    "mc_manager/model"
    "mc_manager/web/views/utils"
    "fmt"
    "time"
    "math"
)

func renderIfElse(condition bool, trueContent string, falseContent string) string {
    if condition {
        return trueContent
    }
    return falseContent
}

templ TotalChart(chartId string, isLive bool, label string, response []model.TotalPlayerTimeResponse, maxDuration time.Duration, usingLocalTime bool, eventList *model.EventListResponse) {
    @playtimeHolder(chartId, false, isLive) {
        @PlaytimeHeader(chartId, label, usingLocalTime, false)
        <table class="charts-css bar multiple show-labels show-primary-axis show-data-axes data-spacing-2" style="--labels-size: 4rem;">
            <tbody>
                for _, player := range response {
                    {{
                        alias := "Unknown Player"
                        if len(player.Aliases) > 0 {
                            alias = player.Aliases[0]
                        }
                    }}
                    <tr>
                        <th scope="row" class="relative group">
                            <span class="absolute left-0 z-50 px-2 py-1 font-normal text-white transition-opacity bg-black rounded opacity-0 pointer-events-none -top-4 w-max group-hover:opacity-100">{alias}</span>
                            <image class="w-12 h-12" src={fmt.Sprintf("/player/%d/avatar/head", player.PlayerId)}/>
                        </th>
                        <td style={fmt.Sprintf("--size: calc( %f / %f )", player.Playtime.Seconds(), math.Max(player.Playtime.Seconds(), maxDuration.Seconds()))}>
                            <span class="flex overflow-hidden">
                                <span class="data text-ellipsis whitespace-nowrap"> 
                                    if player.Playtime.Seconds() > math.Max(player.Playtime.Seconds(), maxDuration.Seconds())*0.1 {
                                        {renderIfElse(player.Playtime.Seconds()>0, utils.HumanizeDuration(player.Playtime), "")}
                                    }
                                </span>
                            </span>
                            <span class="tooltip">{fmt.Sprintf("%s's playtime: %s", alias, utils.HumanizeDuration(player.Playtime))}</span>
                        </td>
                        <td style={fmt.Sprintf("--size: calc( %f / %f )", player.CPUTime.Seconds(), math.Max(player.CPUTime.Seconds(), maxDuration.Seconds()))}>
                            <span class="flex overflow-hidden">
                                <span class="data text-ellipsis whitespace-nowrap"> 
                                    if player.CPUTime.Seconds() > math.Max(player.CPUTime.Seconds(), maxDuration.Seconds())*0.1 {
                                        {renderIfElse(player.CPUTime.Seconds()>0, utils.HumanizeDuration(player.CPUTime), "")}
                                    }
                                </span>
                            </span>
                            <span class="tooltip">{fmt.Sprintf("%s's CPU time: %s", alias, utils.HumanizeDuration(player.CPUTime))}</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        if eventList != nil && len(eventList.Events) > 0 {
            @EventList(eventList.Players, eventList.Events)
        }
    }
}