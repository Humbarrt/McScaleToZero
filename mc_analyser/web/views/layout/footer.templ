package layout


templ Footer() {
    <div class="absolute bottom-0 left-0 right-0 bg-block-bedrock h-1-block">
        <div class="flex w-full h-full px-4 items-center items-row bg-cover bg-gradient-to-t from-[rgba(0,0,0,0.75)] to-[rgba(0,0,0,0.75)]">
            <p class="flex text-xl text-center text-white h-min">By J.A. and M.H.</p>
        </div>
    </div>
}