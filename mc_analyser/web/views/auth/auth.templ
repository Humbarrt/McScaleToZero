package auth

import (
    "mc_analyser/web/views/layout"
)

templ Index() {
    @layout.Base() {
        <div class="flex flex-col items-center justify-center h-full p-4 sm:p-8">
            <div class="w-full h-auto p-6 rounded-lg shadow-md panel sm:w-96">
                <form>
                    <label for="username" class="block mb-2 text-gray-700">Minecraft Username</label>
                    <input type="text" id="username" name="username"
                        class="w-full mb-1 input"
                        style="outline-style: none; outline-offset: -calc\(2*(var(--block-size) / var(--zoom)); outline-width: calc\(2*(var(--block-size) / var(--zoom));"
                        placeholder="Enter your username" />
                    <label for="username" class="hidden mt-1 text-dark-red" id="usernameErrorLabel">Username</label>
                    /* Send Button */
                    <div class="mt-5">
                        <button type="submit" id="signInButton" onclick="signIn(event)"
                            class="w-full px-4 py-2 text-lg raised-slot-button h-1-block whitespace-nowrap">
                            Login
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <script>
            async function addFormError(element, message) {
                element.classList.add("!outline-dark-red");
                element.style.outlineStyle = "solid";
                let error_label = document.getElementById(element.id + "ErrorLabel")
                if (error_label) {
                    error_label.classList.remove("hidden");
                    error_label.innerText = message;
                } else {
                    console.error("Error label not found", element.id + "ErrorLabel")
                }
            }

            async function removeFormError(element) {
                element.classList.remove("!outline-dark-red");
                element.style.outlineStyle = "none";
                let error_label = document.getElementById(element.id + "ErrorLabel")
                if (error_label) {
                    error_label.classList.add("hidden");
                } else {
                    console.error("Error label not found", element.id + "ErrorLabel")
                }
            }

            function validateSignInForm(){
                let username_element = document.getElementById("username");
                let username = username_element?.value || "";
                let is_username_valid = true;

                if (username === "" && is_username_valid) {
                    addFormError(username_element, "Username is required");
                    is_username_valid = false;
                }

                [is_username_valid].forEach((valid, index) => {
                    if (valid) {
                        removeFormError([username_element][index]);
                    }
                })

                return is_username_valid;
            }

            async function signInProcess() {
                try {
                    if (!validateSignInForm()) {
                        return;
                    }
                    username = document.getElementById("username").value
                    sign_in_response = await fetch("/auth/signin", {
                        method: "POST",
                        credentials: 'include',
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            username: username,
                        }),
                    })
                    

                    if (!sign_in_response.ok) {
                        let error = await sign_in_response.json()
                        if (error.error === "username") {
                            addFormError(document.getElementById("username"), error.message)
                        } else {
                            addFormError(document.getElementById("username"), error.message)
                            //errorNotification(error.message) //this project doesn't have errorNotification function
                        }
                    } else {
                        console.log("Sign In Successful")
                        window.location.href = "/"
                    }
                } catch (error) {
                    console.error("Error", error)
                    throw "Error, please try again"
                }
            }

            async function signIn(event) {
                event.preventDefault()
                event.stopPropagation()

                addLoadingIndicator("signIn")
                try {
                    await signInProcess()
                } catch (error) {
                    addFormError(document.getElementById("username"), "Sign In Failed")
                    //errorNotification("Sign In Failed")  //this project doesn't have errorNotification function
                } finally {
                    removeLoadingIndicator("signIn")
                }
            }

            async function addLoadingIndicator(prefix) {
                sign_up_button = document.getElementById(prefix + "Button");
                sign_up_button.disabled = true;

                ["Indicator","Text"].forEach((id) => {
                    document.getElementById(prefix + id)?.classList.add("htmx-request")
                })
            }

            async function removeLoadingIndicator(prefix) {
                ["Indicator","Text"].forEach((id) => {
                    document.getElementById(prefix + id)?.classList.remove("htmx-request")
                })
                sign_up_button.disabled = false;
            }
        </script>
    }
}
