#mandatory envs
SPLITWISE_API_KEY="SPLITWISE_API_KEY"
SPLITWISE_GROUP_ID="SPLITWISE_GROUP_ID"

#optional: default is using file credentials
AWS_ACCESS_KEY_ID_FILE="mc-access-key-id.txt"
AWS_SECRET_ACCESS_KEY_FILE="mc-secret-access-key.txt"

#optional: or define them directly
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

#other optional evns and their defaults
AWS_PROJECT_NAME="Minecraft"
MC_SERVER_SSH_USER="ec2-user"
MC_SERVER_SSH_KEY_FILE="mc-server-key.pem"
DATA_PATH="./data"
DASHBOARD_PORT=8080
TRANSFER_SERVER_PORT=25565